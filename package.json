{
  "name": "lerntyp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @lerntyp/web",
    "build": "npm run build -w @lerntyp/web",
    "build:live": "npm run build:live -w @lerntyp/web",
    "test": "vitest run",
    "lint": "eslint .",
    "validate:data": "tsx scripts/validate-data.ts",
    "check:live": "tsx scripts/check-live.ts",
    "icons": "node scripts/gen-icons.mjs",
    "e2e": "playwright test -c apps/web/playwright.config.ts --trace off",
    "prebuild": "npm run validate:data",
    "prebuild:live": "npm run validate:data"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.11",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
