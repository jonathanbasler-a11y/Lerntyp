  "ueberzeugungen": [
    {
      "id": "U1",
      "text": "Jedes Kind lernt nur auf eine Art richtig gut: entweder mit Bildern oder mit Hören.",
      "audio": "u1.mp3",
      "richtung": "mythos"
    },
    {
      "id": "U2",
      "text": "Wie du lernst, steht seit deiner Geburt fest und ändert sich nie.",
      "audio": "u2.mp3",
      "richtung": "mythos"
    },
    {
      "id": "U3",
      "text": "Gut lernen kann jedes Kind üben.",
      "audio": "u3.mp3",
      "richtung": "wachstum"
    }
  ],
  "vorlieben": [
    {
      "id": "V1",
      "text": "Wenn dir jemand etwas Neues erklärt: Was hilft dir am meisten?",
      "audio": "v1.mp3",
      "rolle": "vorliebe"
    },
    {
      "id": "V2",
      "text": "Wenn du dir etwas für einen Test merken willst: Wie machst du es am liebsten?",
      "audio": "v2.mp3",
      "rolle": "vorliebe"
    },
    {
      "id": "V3",
      "text": "Welche Erklärung magst du am liebsten?",
      "audio": "v3.mp3",
      "rolle": "vorliebe"
    },
    {
      "id": "V4",
      "text": "Gleich zeigen wir dir viele Dinge. Was glaubst du: Wie merkst du sie dir am besten?",
      "audio": "v4.mp3",
      "rolle": "vermutung"
    }
  ],
